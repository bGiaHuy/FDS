{
  "name": "fds-product-suite",
  "private": true,
  "version": "0.1.0",
  "description": "FPTU Data Science Club product websites: public site, admin dashboard, and NestJS API.",
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:admin": "npm --prefix admin run dev",
    "dev:backend": "npm --prefix backend run start:dev",
    "start:dev": "npm --prefix backend run start:dev",
    "dev": "npm run dev:frontend",
    "db:up": "npm --prefix backend run prisma:deploy",
    "db:down": "docker compose down",
    "docker:up": "npm run db:up && docker compose up --build",
    "docker:down": "docker compose down",
    "reviews:sync": "node frontend/scripts/sync-reviews.mjs",
    "reviews:watch": "node frontend/scripts/sync-reviews.mjs --watch"
  }
}
