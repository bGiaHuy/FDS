# On the deployed frontend server (never use NEXT_PUBLIC_ for the token).
FDS_ENABLE_REVIEW=1
FDS_REVIEW_DIRECTORY=/app/review-data
FDS_REVIEW_SITE_ORIGIN=https://your-club-domain.example
FDS_REVIEW_TOKEN=replace-with-a-random-secret-at-least-32-characters

# On your computer: copy the URL and the same token into .env.review.local.
FDS_REVIEW_REMOTE_URL=https://your-club-domain.example
